# Python virtual environments
.venv/
venv/
env/

# Python cache
__pycache__/
*.py[cod]
*.class

# Test / tooling cache
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Jupyter
.ipynb_checkpoints/

# Environment / secrets
.env
.env.*
!.env.example

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini


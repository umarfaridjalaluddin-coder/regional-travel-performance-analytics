*.pbit.tmp
~$*.pbix

# Generated outputs
outputs/*
!outputs/.gitkeep

# Processed/generated data
data/staging/*
data/silver/*
data/gold/*

# Keep placeholder files
!data/staging/.gitkeep
!data/silver/.gitkeep
!data/gold/.gitkeep
